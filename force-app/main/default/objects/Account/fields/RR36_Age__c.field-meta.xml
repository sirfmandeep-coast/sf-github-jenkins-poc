<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RR36_Age__c</fullName>
    <description>CRM-4266 - Calculates age from when RR Date is stamped.
CRM-6109 - Updated to PD_Rating__c</description>
    <externalId>false</externalId>
    <formula>IF(
ISPICKVAL(PD_Rating__c, &quot;36&quot;),

TODAY() - RR36_Date_Stamp__c, 0

)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>PD 36 Age</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
