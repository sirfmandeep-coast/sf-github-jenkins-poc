<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LGD_Score_Range</fullName>
    <active>false</active>
    <description>CRM-3186 - Deprecated per CRM-3691</description>
    <errorConditionFormula>OR
(
LGD_Score__c &lt; 0,
LGD_Score__c &gt; 99.99
)</errorConditionFormula>
    <errorDisplayField>LGD_Score__c</errorDisplayField>
    <errorMessage>**** DEPRECATED **** Please enter a valid value within the range: 0 to 99.99</errorMessage>
</ValidationRule>
